# ============================================================
# AI Photo Studio 環境変数
# このファイルを .env.local にコピーして値を設定してください
#   cp .env.example .env.local
# キー未設定の項目は自動的に「デモモード」で動作します
# ============================================================

# --- AI画像生成 (Google Gemini) ---
# https://aistudio.google.com/apikey で取得
# 未設定の場合: アップロード写真を加工したダミー画像でフロー確認できます
GEMINI_API_KEY=

# 使用モデル (省略可 / 既定: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- 決済 (Stripe) ---
# https://dashboard.stripe.com/apikeys で取得
# 未設定の場合: デモ決済(即時成功)で動作します
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- サイトURL (Stripeのリダイレクト先に使用) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 生成データ保存先 (省略可 / 既定: プロジェクト直下の .data) ---
# DATA_DIR=/var/photo-data

# --- ブランド設定 (省略可 / 既定値は lib/branding.ts を参照) ---
# サイト名・透かし・ファイル名をコード変更なしで差し替えられます
# NEXT_PUBLIC_BRAND_NAME=ハレノヒ写真館
# NEXT_PUBLIC_BRAND_NAME_EN=HARENOHI PHOTO STUDIO
# NEXT_PUBLIC_BRAND_WATERMARK=HARENOHI
# NEXT_PUBLIC_BRAND_FILE_PREFIX=harenohi
